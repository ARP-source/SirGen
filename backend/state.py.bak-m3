"""Single authoritative Sentinel-OR state plus pub/sub to WebSocket clients.

Every other module changes state only through `StateStore.update`. The store
broadcasts the full state JSON to subscribers on change, throttled to about
10 Hz. `update(..., urgent=True)` bypasses the throttle and publishes at once
(alerts never wait, hard rule 3).

The store is used from the asyncio event loop only (no locks needed).
"""
from __future__ import annotations

import asyncio
import logging
import time
from typing import Any, Literal, Optional

from pydantic import BaseModel, Field

log = logging.getLogger("sentinel.state")

ATTRIBUTION = (
    "Video: Cholec80, CAMMA (CC BY-NC-SA 4.0). "
    "Vitals: VitalDB case 59, Lee HC et al., Sci Data 2022 (CC BY 4.0)."
)
FOOTAGE_LABEL = "Recorded footage · Research prototype"
COMPOSITE_LABEL = (
    "Composite of two de-identified public cases (Cholec80 video, VitalDB case 59 vitals). "
    "Some chart fields and scenarios synthetic."
)
CONTEXT_UNAVAILABLE = "Context unavailable. Source record remains available for review."
AGENT_IDLE = "idle: waits for an event"
AGENTS_NOT_ATTACHED = "no agent orchestrator attached"
NOT_MEASURED = "not measured"

AgentName = Literal["surgical", "anesthesia", "record"]


class ScenarioInfo(BaseModel):
    id: str = ""
    title: str = ""
    on_screen_label: str = ""
    duration_s: float = 0.0
    event_t_s: Optional[float] = None
    event_note: str = ""
    alert_level: Literal["banner", "quiet"] = "banner"


class PhaseState(BaseModel):
    name: Optional[str] = None
    display: Optional[str] = None
    since_s: Optional[float] = None
    tools_window: dict[str, int] = Field(default_factory=dict)
    status: str = "detector not running (M2)"
    set_by: Optional[Literal["tracker", "presenter"]] = None


class Vitals(BaseModel):
    t_s: Optional[int] = None
    hr: Optional[float] = None
    sbp: Optional[float] = None
    dbp: Optional[float] = None
    map: Optional[float] = None
    spo2: Optional[float] = None
    source: str = ""
    source_kind: Literal["simulated", "approximate", "real_time_shifted", "none"] = "none"
    source_id: str = "vit-art"


class DrugEntry(BaseModel):
    t_s: Optional[float] = None
    drug: str
    detail: str
    source_id: str
    provenance: str


class NibpEntry(BaseModel):
    t_s: Optional[float] = None
    sbp: Optional[float] = None
    dbp: Optional[float] = None
    map: Optional[float] = None
    source_id: str
    provenance: str


class Event(BaseModel):
    event_id: str
    event_type: Literal["map_drop", "art_spike"]
    event_timestamp: float
    trigger: Literal["scenario", "presenter"]
    simulated: bool
    alert_shown_at: Optional[float] = None
    alert_level: Literal["banner", "quiet"] = "banner"
    alert_text: str = ""
    detect_lag_ms: Optional[float] = None
    event_to_alert_ms: Optional[float] = None
    context_status: Literal["pending", "available", "unavailable"] = "pending"
    context_note: str = ""


class TimelineItem(BaseModel):
    t_s: float
    kind: Literal["event", "alert", "context", "baseline", "info"]
    label: str
    event_id: Optional[str] = None


class AgentSlot(BaseModel):
    """One agent column. `message` is the latest validated AgentMessage (round 2 once it
    arrives, else round 1); `round1` keeps the validated round-1 message. A failed agent
    has status "unavailable" and a `reason`; nothing is ever written in place of its output."""
    status: str = AGENT_IDLE
    state: Literal["idle", "waiting", "thinking", "done", "unavailable"] = "idle"
    message: Optional[dict[str, Any]] = None
    round1: Optional[dict[str, Any]] = None
    reason: Optional[str] = None
    sees: list[dict[str, Any]] = Field(default_factory=list)
    allowed_source_ids: list[str] = Field(default_factory=list)
    latency_ms: Optional[float] = None
    attempts: int = 0


class Deliberation(BaseModel):
    """`outcome`, `team_question` and `summary` are decided by code (agents/convergence.py)."""
    status: str = AGENT_IDLE
    round: int = 0
    outcome: Optional[Literal["converged", "split", "pending"]] = None
    team_question: Optional[str] = None
    summary: Optional[str] = None
    shared_category: Optional[str] = None
    sides: list[dict[str, Any]] = Field(default_factory=list)
    question_source_ids: list[str] = Field(default_factory=list)
    unavailable_agents: list[str] = Field(default_factory=list)


class Baseline(BaseModel):
    rule: str = "MAP < 65 for >= 60 s, or SBP > 180 for >= 5 s"
    rule_text: str = ""
    alarm: bool = False
    fired_rule: Optional[str] = None
    fired_at_t_s: Optional[int] = None
    expected_fires: Optional[str] = None
    expected_fires_at_t_s: Optional[float] = None
    expected_correct: Optional[bool] = None
    comment: str = ""


class Metrics(BaseModel):
    render_fps: Optional[float] = None
    detector_fps: Optional[float] = None
    detector_ms: Optional[float] = None
    event_to_alert_ms: Optional[float] = None
    deliberation_s: Optional[float] = None
    gb_used: Optional[float] = None
    bytes_out: Optional[int] = None
    models_resident: Optional[list[str]] = None
    notes: dict[str, str] = Field(default_factory=lambda: {
        "event_to_alert_ms": "event detected in code -> alert state published to WS clients",
        "bytes_out": "sum of tx_bytes deltas on non-loopback interfaces since backend start (/proc/net/dev)",
        "render_fps": "frames decoded, encoded and published to /video.mjpg per second",
        "deliberation_s": "wall clock from the start of round 1 to the code-decided outcome (excludes the wait for an art_spike to recover)",
    })


class VideoInfo(BaseModel):
    source: Optional[str] = None
    label: str = ""
    test_pattern: bool = True
    frame_id: int = 0
    source_fps: Optional[float] = None
    dropped_frames: int = 0
    detector: str = "not running (M2)"


class Labels(BaseModel):
    footage: str = FOOTAGE_LABEL
    attribution: str = ATTRIBUTION
    composite: str = COMPOSITE_LABEL
    context_unavailable: str = CONTEXT_UNAVAILABLE


def _default_agents() -> dict[str, AgentSlot]:
    return {name: AgentSlot() for name in ("surgical", "anesthesia", "record")}


class SentinelState(BaseModel):
    scenario_id: Optional[str] = None
    scenario: ScenarioInfo = Field(default_factory=ScenarioInfo)
    clock_s: float = 0.0
    playing: bool = False
    ended: bool = False
    phase: PhaseState = Field(default_factory=PhaseState)
    vitals: Vitals = Field(default_factory=Vitals)
    nibp: list[NibpEntry] = Field(default_factory=list)
    drug_log: list[DrugEntry] = Field(default_factory=list)
    event: Optional[Event] = None
    timeline: list[TimelineItem] = Field(default_factory=list)
    agents: dict[str, AgentSlot] = Field(default_factory=_default_agents)
    deliberation: Deliberation = Field(default_factory=Deliberation)
    baseline: Baseline = Field(default_factory=Baseline)
    metrics: Metrics = Field(default_factory=Metrics)
    video: VideoInfo = Field(default_factory=VideoInfo)
    labels: Labels = Field(default_factory=Labels)


class StateStore:
    """Holds the state, tracks versions and fans snapshots out to subscribers."""

    def __init__(self, min_interval_s: float = 0.1) -> None:
        self._state = SentinelState()
        self._version = 0
        self._published_version = 0
        self._last_publish = 0.0
        self._min_interval_s = min_interval_s
        self._subscribers: set[asyncio.Queue[str]] = set()
        self._dirty = asyncio.Event()
        self.publish_count = 0

    @property
    def state(self) -> SentinelState:
        """Read-only view; mutate only through `update`."""
        return self._state

    @property
    def version(self) -> int:
        return self._version

    def snapshot(self) -> dict[str, Any]:
        return self._state.model_dump(mode="json")

    def snapshot_json(self) -> str:
        return self._state.model_dump_json()

    def update(self, urgent: bool = False, **fields: Any) -> float:
        """Replace top-level fields. Returns the perf_counter time of publication
        for urgent updates (0.0 otherwise)."""
        for key, value in fields.items():
            if key not in SentinelState.model_fields:
                raise KeyError(f"unknown state field: {key}")
            setattr(self._state, key, value)
        self._version += 1
        if urgent:
            self._publish()
            return time.perf_counter()
        self._dirty.set()
        return 0.0

    def subscribe(self) -> asyncio.Queue[str]:
        queue: asyncio.Queue[str] = asyncio.Queue(maxsize=1)
        queue.put_nowait(self.snapshot_json())
        self._subscribers.add(queue)
        return queue

    def unsubscribe(self, queue: asyncio.Queue[str]) -> None:
        self._subscribers.discard(queue)

    @property
    def subscriber_count(self) -> int:
        return len(self._subscribers)

    def _publish(self) -> None:
        payload = self.snapshot_json()
        for queue in self._subscribers:
            if queue.full():  # conflate: a slow client only ever gets the latest state
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    pass
            queue.put_nowait(payload)
        self._published_version = self._version
        self._last_publish = time.monotonic()
        self.publish_count += 1

    async def run_broadcaster(self) -> None:
        """Publish pending changes, at most once per `min_interval_s`."""
        while True:
            await self._dirty.wait()
            self._dirty.clear()
            wait = self._last_publish + self._min_interval_s - time.monotonic()
            if wait > 0:
                await asyncio.sleep(wait)
            if self._published_version < self._version:
                self._publish()
